# SecureGraph API base for published Weekly posts. Leave unset to run with the
# bundled demo posts in src/content/posts/. Posts are written and published in
# the Staff Portal (/weekly); this app only reads.
#
#   absolute:    VITE_BLOG_API_URL=https://staging.phantix.site/api/v1/blog
#   same-origin: VITE_BLOG_API_URL=/api/v1/blog  (vercel.json rewrites /api/v1)
VITE_BLOG_API_URL=

# Analytics beacon endpoint (defaults to /api/v1/analytics/collect).
# VITE_ANALYTICS_URL=/api/v1/analytics/collect
# VITE_ANALYTICS_DISABLED=false

# Newsletter/subscribe target (defaults to the Substack subscribe page).
# VITE_NEWSLETTER_URL=//securegraph.substack.com/subscribe
